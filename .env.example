# Copy to .env for local dev, or .env.production for production builds.
# Never commit the real .env files — they are git-ignored.

# URL of your deployed Flask backend (no trailing slash)
VITE_API_URL=https://your-backend-url-here.com

# Additional sub-site domains -- same app, same deployment, every domain
# added as a Production Domain on this one Vercel project. Comma-separated
# hostnames (no protocol, no trailing slash; include both the bare domain
# and www. if you serve both). Locally, use ?site=business / ?site=estates /
# ?site=money / ?site=torah / ?site=news / ?site=main instead of setting
# these -- see src/sites/registry.js for the full list of registered sites.
VITE_BUSINESS_HOSTNAMES=
VITE_ESTATES_HOSTNAMES=
VITE_MONEY_HOSTNAMES=
VITE_TORAH_HOSTNAMES=
VITE_NEWS_HOSTNAMES=
VITE_MAIN_HOSTNAMES=

# Business-owner storefronts (site builder) -- unlike the fixed sub-site
# hostnames above, these are created dynamically (one per business, at
# signup), so there's no fixed list to put here. Instead this is the BASE
# domain(s) added as a Wildcard Domain on this Vercel project (e.g.
# "gutcommunity.com", so that *.gutcommunity.com all reach this
# deployment) -- comma-separated if more than one. Leave empty until a
# wildcard domain is actually configured in Vercel; nothing in the code
# depends on a specific value. Locally, use ?site=business-site&subdomain=foo
# instead of setting this.
VITE_BUSINESS_SITE_WILDCARD_DOMAINS=

# Cloudflare Turnstile (CAPTCHA) on the storefront's checkout/booking forms
# -- the public SITE key (dash.cloudflare.com -> Turnstile -> Add site,
# Managed mode). The matching SECRET key goes in the backend's
# TURNSTILE_SECRET_KEY. Leave blank to skip CAPTCHA entirely -- the widget
# just doesn't render and checkout/booking proceed without it.
VITE_TURNSTILE_SITE_KEY=

# Translation tool (../../translationtool) -- lets visitors translate any
# site into ~40 languages via a dropdown. The project key is public (like
# an analytics id), safe to commit. apiUrl points at the translation
# server: locally that's `npm run dev` in translationtool (port 3100);
# in production it's wherever translationtool/apps/server is deployed.
VITE_TRANSLATE_API_URL=
VITE_TRANSLATE_PROJECT_KEY=
