# Copy to .env for local dev, or .env.production for production builds.
# Never commit the real .env files — they are git-ignored.

# URL of your deployed Flask backend (no trailing slash)
VITE_API_URL=https://your-backend-url-here.com

# Second-domain business site (Good Shtick Business) -- same app, same
# deployment, both domains added as Production Domains on this one Vercel
# project. Comma-separated hostnames (no protocol, no trailing slash).
# Locally, use ?site=business or ?site=main instead of setting these.
VITE_BUSINESS_HOSTNAMES=
VITE_MAIN_HOSTNAMES=
