    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.gutshtick.com" }],
      "destination": "/api/static-meta?route=main_home"
    },

    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
